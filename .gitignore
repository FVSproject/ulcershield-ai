# ────────────────────────────────────────────────────────────────
# UlcerShield AI — repo-wide .gitignore
# ────────────────────────────────────────────────────────────────

# Node / Next.js
node_modules/
.next/
out/
.turbo/
next-env.d.ts

# Env / secrets — never commit these
.env
.env.*
!.env.example
platform/.env
platform/.env.*
!platform/.env.example

# Vercel
.vercel/
platform/.vercel/

# IDE / OS
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# Logs / debug
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build artefacts
*.tsbuildinfo
.next-*/

# Private research images (contain personal WhatsApp exports).
# Remove this line if you want to commit the research to the public repo.
report/

# Arduino build artefacts
firmware/build/
firmware/.build/
